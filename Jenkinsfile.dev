// Pipeline 1 : Developpement / Tests
// Se declenche a chaque modification du code sur GitHub, compile, genere l'executable et lance les tests.

pipeline {
    agent any

    triggers {
        githubPush()
        // Jenkins en local n'est pas joignable par GitHub sans tunnel : la scrutation sert de filet
        pollSCM('H/2 * * * *')
    }

    stages {
        stage('Compilation') {
            steps { sh 'make distclean && make' }
        }

        stage('Tests') {
            steps { sh 'make test' }
        }

        stage('Execution') {
            steps { sh './tri_bulles && ./tri_bulles 8 3 9 1' }
        }
    }

    post {
        success {
            archiveArtifacts artifacts: 'tri_bulles', fingerprint: true
            build job: 'tri-bulles-preprod', wait: false
        }
        failure {
            echo 'Dev en echec : compilation ou tests. La pre-prod n est pas lancee.'
        }
    }
}
